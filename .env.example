# Copy to your server's environment. Never commit real values.
# Akamai Cloud Inference (OpenAI-compatible API)
AI_BASE_URL=https://<your-inference-endpoint>/v1
AI_API_KEY=
AI_MODEL=
AI_VISION=1            # 1 if the model accepts images (lets Cue read the shared screen)
STT_MODEL=             # speech-to-text model name, for captions of the other side of a call
# Akamai Object Storage (S3 API), for saved recaps
S3_ENDPOINT=https://<region>.linodeobjects.com
S3_REGION=<region>
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
PORT=8787
